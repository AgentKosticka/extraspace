<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black">
    <SurfaceView android:id="@+id/surface" android:layout_width="match_parent" android:layout_height="match_parent" />
    <ImageView android:id="@+id/cursor" android:layout_width="1dp" android:layout_height="1dp"
        android:layout_gravity="top|start" android:clickable="false" android:focusable="false"
        android:importantForAccessibility="no" android:scaleType="fitXY" android:visibility="gone" />
    <ScrollView android:id="@+id/lobby" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:background="@color/xs_window">
        <LinearLayout android:id="@+id/lobby_content" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal">
                <ImageView android:layout_width="80dp" android:layout_height="80dp"
                    android:src="@drawable/brand_icon" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textColor="@color/xs_text" android:textSize="28sp"
                    android:textStyle="bold" android:layout_marginTop="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/product_subtitle" android:textColor="@color/xs_muted" android:textSize="16sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="24dp" android:padding="20dp"
                android:background="@drawable/settings_card">
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/xs_text" android:textSize="20sp" android:textStyle="bold"
                    android:text="@string/waiting_for_host" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/device_details" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="@color/xs_muted" android:textSize="14sp" android:paddingTop="8dp" android:textIsSelectable="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="end" android:layout_marginTop="12dp">
                    <androidx.appcompat.widget.AppCompatButton style="@style/Extraspace.Button" android:id="@+id/display_test" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/display_test" />
                    <androidx.appcompat.widget.AppCompatButton style="@style/Extraspace.Button" android:id="@+id/retry" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/retry" android:textColor="@color/xs_accent_text"
                        android:background="@drawable/button_primary" android:layout_marginStart="8dp" />
                    <androidx.appcompat.widget.AppCompatButton style="@style/Extraspace.Button" android:id="@+id/resume" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="@string/resume_display" android:visibility="gone"
                        android:textColor="@color/xs_accent_text" android:background="@drawable/button_primary" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/Extraspace.SectionTitle" android:text="@string/usb_connection" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:background="@drawable/settings_card">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/usb_method" android:textColor="@color/xs_text" android:textSize="16sp" />
                <androidx.appcompat.widget.AppCompatSpinner android:id="@+id/connection_method" android:layout_width="match_parent"
                    android:layout_height="48dp" android:contentDescription="@string/usb_method" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/connection_help" android:textColor="@color/xs_muted" android:textSize="14sp" />
            </LinearLayout>
            <TextView style="@style/Extraspace.SectionTitle" android:text="@string/display_settings" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp" android:background="@drawable/settings_card">
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/device_processing" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:textColor="@color/xs_text"
                    android:textSize="16sp" android:text="@string/device_processing" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/processing_help" android:textColor="@color/xs_muted" android:textSize="14sp" />
            </LinearLayout>
            <TextView style="@style/Extraspace.SectionTitle" android:text="@string/getting_started" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/setup_help" android:textColor="@color/xs_muted" android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
