<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Extraspace" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/xs_accent</item>
        <item name="colorPrimary">@color/xs_accent</item>
        <item name="android:colorBackground">@color/xs_window</item>
        <item name="android:textColorPrimary">@color/xs_text</item>
        <item name="android:textColorSecondary">@color/xs_muted</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Extraspace.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/xs_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>
    <style name="Extraspace.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/xs_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.Extraspace.Fullscreen" parent="Theme.Extraspace">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
